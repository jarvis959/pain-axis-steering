diff --git a/src/llama-pain.cpp b/src/llama-pain.cpp
new file mode 100644
index 000000000..500e54194
--- /dev/null
+++ b/src/llama-pain.cpp
@@ -0,0 +1,231 @@
+// pain-axis steering (arXiv 2609.16247) - local patch, see LLAMA-PAIN-NOTES.md
+//
+// single process-wide owner of the steering vector and of the runtime-mutable dose.
+//
+// dose semantics: residual += dose * vec, where vec is the raw vector read from the
+// --pain-vector file (so dose 1.0 == the paper's steering coefficient 1).
+//
+// the dose can be changed from any thread at any time (llama-server POST /pain): the new
+// scaled vector is recomputed on the host here, and uploaded to the device by the graph's
+// input setup (llm_graph_input_pain::set_input) on the next decode step - no graph rebuild
+// and no CUDA graph recapture is involved, see LLAMA-PAIN-NOTES.md.
+
+#include "llama-pain.h"
+#include "llama-impl.h"
+
+#include <cctype>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <mutex>
+#include <string>
+#include <vector>
+
+// all state is guarded by g_mutex - it is written by llama_pain_set_dose() (HTTP thread)
+// and read by llm_graph_input_pain::set_input() (inference thread)
+static std::mutex         g_mutex;
+static bool               g_enabled = false;
+static int32_t            g_layer   = -1;
+static int32_t            g_n_embd  = 0;
+static float              g_dose    = 1.0f;
+static std::string        g_path;
+static std::vector<float> g_vec;     // raw vector from the .f16 file
+static std::vector<float> g_scaled;  // g_dose * g_vec, recomputed on every dose change
+
+static std::string g_error;          // last llama_pain_configure() error (returned as const char *)
+
+static const char * set_error(const std::string & msg) {
+    g_error = msg;
+    return g_error.c_str();
+}
+
+static std::string read_file_text(const std::string & path) {
+    std::ifstream f(path, std::ios::binary);
+    if (!f) {
+        return {};
+    }
+    return { std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>() };
+}
+
+// minimal lookup of "<key>": <int> in a flat JSON document (pain_meta.json)
+static bool find_json_int(const std::string & text, const std::string & key, int64_t & out) {
+    const std::string pat = "\"" + key + "\"";
+
+    size_t pos = text.find(pat);
+    if (pos == std::string::npos) {
+        return false;
+    }
+
+    pos = text.find(':', pos + pat.size());
+    if (pos == std::string::npos) {
+        return false;
+    }
+
+    pos++;
+    while (pos < text.size() && std::isspace((unsigned char) text[pos])) {
+        pos++;
+    }
+
+    size_t end = pos;
+    if (end < text.size() && (text[end] == '-' || text[end] == '+')) {
+        end++;
+    }
+    while (end < text.size() && std::isdigit((unsigned char) text[end])) {
+        end++;
+    }
+
+    if (end == pos) {
+        return false;
+    }
+
+    try {
+        out = std::stoll(text.substr(pos, end - pos));
+    } catch (...) {
+        return false;
+    }
+
+    return true;
+}
+
+// load the steering vector from a raw .f16 file (n little-endian float16 values)
+// layer < 0 -> take "steer_layer" from the sibling pain_meta.json, error out if absent
+// returns NULL on success, or a static error message (steering stays disabled)
+const char * llama_pain_configure(const char * path, int32_t layer) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+
+    // reset (also covers the "disabled" path: path == NULL / "")
+    g_enabled = false;
+    g_layer   = -1;
+    g_n_embd  = 0;
+    g_dose    = 1.0f;
+    g_path.clear();
+    g_vec.clear();
+    g_scaled.clear();
+
+    if (path == nullptr || path[0] == '\0') {
+        return nullptr;
+    }
+
+    const std::string p(path);
+
+    // read the raw vector: n little-endian float16 values
+    std::ifstream f(p, std::ios::binary | std::ios::ate);
+    if (!f) {
+        return set_error("pain steering: cannot open --pain-vector file '" + p + "'");
+    }
+
+    const std::streamoff size = f.tellg();
+    if (size <= 0 || size % 2 != 0) {
+        return set_error("pain steering: '" + p + "' must be a raw .f16 file with a positive, even number of bytes");
+    }
+
+    const int32_t n = (int32_t) (size / 2);
+
+    f.seekg(0, std::ios::beg);
+    std::vector<unsigned char> bytes((size_t) size);
+    if (!f.read((char *) bytes.data(), size)) {
+        return set_error("pain steering: failed to read '" + p + "'");
+    }
+
+    std::vector<float> vec(n);
+    for (int32_t i = 0; i < n; ++i) {
+        const uint16_t h = (uint16_t) (bytes[2*i] | (bytes[2*i + 1] << 8)); // little-endian
+        vec[i] = ggml_fp16_to_fp32(h);
+    }
+
+    // sibling pain_meta.json (same directory as the vector file): layer fallback + n_embd cross-check
+    const size_t slash = p.find_last_of('/');
+    const std::string dir = slash == std::string::npos ? std::string(".") : (slash == 0 ? std::string("/") : p.substr(0, slash));
+    const std::string meta_path = dir + "/pain_meta.json";
+    const std::string meta = read_file_text(meta_path);
+
+    int64_t meta_layer  = -1;
+    int64_t meta_n_embd = -1;
+    if (!meta.empty()) {
+        find_json_int(meta, "steer_layer", meta_layer);
+        find_json_int(meta, "n_embd",      meta_n_embd);
+    }
+
+    if (layer < 0) {
+        if (meta_layer < 0) {
+            return set_error("pain steering: no --pain-layer given and no \"steer_layer\" found in '" + meta_path + "'");
+        }
+        layer = (int32_t) meta_layer;
+    }
+
+    if (meta_n_embd > 0 && meta_n_embd != n) {
+        return set_error("pain steering: '" + p + "' has " + std::to_string(n) + " values but '" +
+                meta_path + "' says n_embd = " + std::to_string(meta_n_embd));
+    }
+
+    g_vec    = std::move(vec);
+    g_n_embd = n;
+    g_layer  = layer;
+    g_path   = p;
+    g_dose   = 1.0f; // dose 1.0 == the paper's steering coefficient
+    g_scaled.resize(n);
+    for (int32_t i = 0; i < n; ++i) {
+        g_scaled[i] = g_dose * g_vec[i];
+    }
+    g_enabled = true;
+
+    LLAMA_LOG_INFO("%s: pain steering: loaded %s (%d values, layer %d, dose %.3f)\n",
+            __func__, g_path.c_str(), g_n_embd, g_layer, g_dose);
+
+    return nullptr;
+}
+
+int32_t llama_pain_enabled(void) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_enabled ? 1 : 0;
+}
+
+int32_t llama_pain_layer(void) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_layer;
+}
+
+int32_t llama_pain_n_embd(void) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_n_embd;
+}
+
+const char * llama_pain_vector_path(void) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_path.c_str();
+}
+
+float llama_pain_get_dose(void) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_dose;
+}
+
+float llama_pain_set_dose(float dose) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+
+    if (!g_enabled) {
+        return g_dose;
+    }
+
+    g_dose = dose;
+    for (size_t i = 0; i < g_vec.size(); ++i) {
+        g_scaled[i] = g_dose * g_vec[i];
+    }
+
+    LLAMA_LOG_INFO("%s: pain steering: dose = %.4f\n", __func__, g_dose);
+
+    return g_dose;
+}
+
+bool llama_pain_copy_scaled(float * dst, int n) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+
+    if (!g_enabled || n != g_n_embd) {
+        return false;
+    }
+
+    std::memcpy(dst, g_scaled.data(), (size_t) n * sizeof(float));
+
+    return true;
+}
